[Unit]
Description=Charlotte web server
After=network.target
ConditionPathExists=/etc/charlotte/charlotte.yaml

[Service]
Type=simple
EnvironmentFile=-/etc/default/project-charlotte
ExecStart=/usr/bin/project-charlotte $CHARLOTTE_OPTS
RuntimeDirectory=charlotte
StateDirectory=charlotte
LogsDirectory=charlotte
KillMode=mixed
Restart=on-failure
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=true

[Install]
WantedBy=multi-user.target